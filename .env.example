APP_ENV=development
APP_URL=http://localhost:8080

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phalcon
DB_USERNAME=phalcon
DB_PASSWORD=troque_por_uma_senha_forte

MYSQL_ROOT_PASSWORD=troque_por_outra_senha_forte

ADMIN_EMAIL=admin@phalcon.local
ADMIN_PASSWORD=troque_por_uma_senha_forte_para_o_admin

# Usuario com acesso total ao SaaS. Se ficar vazio, ADMIN_EMAIL/ADMIN_PASSWORD
# serao usados e promovidos para master pela migration.
MASTER_NAME=Administrador Master
MASTER_EMAIL=
MASTER_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

# Dados exibidos nos Termos de Uso e Politica de Privacidade.
# Em homologacao/producao, preencha com os dados reais antes de liberar.
LEGAL_APP_URL=http://localhost:8080
LEGAL_COMPANY_NAME=NexoCore Tecnologia LTDA
LEGAL_COMPANY_CNPJ=a_preencher
LEGAL_FORUM=Cidade/UF a preencher
LEGAL_CONTACT_EMAIL=contato@nexocoretecnologia.com.br
LEGAL_PRIVACY_EMAIL=privacidade@nexocoretecnologia.com.br
LEGAL_HOSTING_REGION=Google Cloud, regiao a definir
LEGAL_UPDATED_AT=20 de agosto de 2026

# Producao na VM (dominio + HTTPS via Caddy).
# Em producao, defina tambem APP_ENV=production acima.
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Imagem publicada no Artifact Registry (build feito pelo Cloud Build, nao na VM).
# Para homologacao/producao, prefira tag imutavel do commit em vez de latest.
# Formato: REGIAO-docker.pkg.dev/SEU_PROJETO/REPOSITORIO/app:SHORT_SHA
APP_IMAGE=southamerica-east1-docker.pkg.dev/SEU_PROJETO/phalcon/app:latest
