APP_ENV=development

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phalcon
DB_USERNAME=phalcon
DB_PASSWORD=troque_por_uma_senha_forte

MYSQL_ROOT_PASSWORD=troque_por_outra_senha_forte

ADMIN_EMAIL=admin@phalcon.local
ADMIN_PASSWORD=troque_por_uma_senha_forte_para_o_admin

REDIS_HOST=redis
REDIS_PORT=6379

# Producao na VM (dominio + HTTPS via Caddy).
# Em producao, defina tambem APP_ENV=production acima.
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Imagem publicada no Artifact Registry (build feito pelo Cloud Build, nao na VM).
# Formato: REGIAO-docker.pkg.dev/SEU_PROJETO/REPOSITORIO/app:latest
APP_IMAGE=southamerica-east1-docker.pkg.dev/SEU_PROJETO/phalcon/app:latest
