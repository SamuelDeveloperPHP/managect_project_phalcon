<?php $this->partial('header', ['pageTitle' => $pageTitle, 'csrfToken' => $csrfToken]); ?>
<?php $this->partial('navbar', ['auth' => $auth]); ?>
<?php $this->partial('sidebar', ['auth' => $auth, 'csrfToken' => $csrfToken, 'currentPage' => 'versions']); ?>

<main class="admin-content">
    <section class="page-hero compact-hero releases-hero">
        <div>
            <p class="eyebrow">Notas de release</p>
            <h1>Histórico de melhorias</h1>
            <p class="muted">Acompanhe o que foi implantado, corrigido e atualizado em cada versão publicada.</p>
        </div>
    </section>

    <?php if ($versions === []): ?>
        <section class="panel versions-panel"><p class="empty-state">Nenhuma versão foi registrada ainda.</p></section>
    <?php else: ?>
        <section class="release-timeline" aria-label="Histórico de melhorias">
            <?php foreach ($versions as $entry): ?>
                <?php $version = $entry['model']; $notes = $entry['notes']; ?>
                <article class="release-card">
                    <div class="release-marker" aria-hidden="true"></div>
                    <header class="release-header">
                        <div>
                            <p class="release-date"><?= (new DateTimeImmutable((string) $version->released_at))->format('d/m/Y') ?></p>
                            <h2>Versão <code><?= htmlspecialchars(substr((string) $version->commit_sha, 0, 12), ENT_QUOTES, 'UTF-8') ?></code></h2>
                        </div>
                        <span class="release-branch"><?= htmlspecialchars((string) $version->branch_name, ENT_QUOTES, 'UTF-8') ?></span>
                    </header>

                    <?php if ($version->commit_message): ?>
                        <p class="release-summary"><?= htmlspecialchars((string) $version->commit_message, ENT_QUOTES, 'UTF-8') ?></p>
                    <?php endif; ?>

                    <?php foreach (['implemented' => ['Implantado', 'release-section-implemented'], 'fixed' => ['Corrigido', 'release-section-fixed'], 'updated' => ['Atualizado', 'release-section-updated']] as $key => [$label, $class]): ?>
                        <?php if ($notes[$key] !== []): ?>
                            <section class="release-section <?= $class ?>">
                                <h3><?= $label ?> <span><?= count($notes[$key]) ?></span></h3>
                                <ul><?php foreach ($notes[$key] as $note): ?><li><?= htmlspecialchars($note, ENT_QUOTES, 'UTF-8') ?></li><?php endforeach; ?></ul>
                            </section>
                        <?php endif; ?>
                    <?php endforeach; ?>

                    <footer class="release-meta">
                        <span>Commit <code><?= htmlspecialchars((string) $version->commit_sha, ENT_QUOTES, 'UTF-8') ?></code></span>
                        <span>Publicado em <?= (new DateTimeImmutable((string) $version->released_at))->format('d/m/Y H:i') ?></span>
                        <span>Executado por <?= htmlspecialchars((string) $version->executed_by, ENT_QUOTES, 'UTF-8') ?></span>
                    </footer>
                </article>
            <?php endforeach; ?>
        </section>
    <?php endif; ?>
</main>

<?php $this->partial('footer'); ?>
