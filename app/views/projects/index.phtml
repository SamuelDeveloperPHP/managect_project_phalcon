<?php $this->partial('header', ['pageTitle' => $pageTitle, 'csrfToken' => $csrfToken]); ?>
<?php $this->partial('navbar', ['auth' => $auth]); ?>
<?php $this->partial('sidebar', ['auth' => $auth, 'csrfToken' => $csrfToken, 'currentPage' => 'projects']); ?>

<?php
$statusLabels = [
    'planning' => 'Planejamento',
    'in_progress' => 'Em andamento',
    'completed' => 'Concluido',
    'paused' => 'Pausado',
];
$statusClasses = [
    'planning' => 'status-info',
    'in_progress' => 'status-info',
    'completed' => 'status-success',
    'paused' => 'status-muted',
];
?>

<main class="admin-content">
    <div class="flash"><?= $this->flashSession->output() ?></div>

    <section class="page-hero compact-hero">
        <div>
            <p class="eyebrow">Projetos</p>
            <h1>Lista de projetos</h1>
        </div>

        <a class="btn btn-primary btn-sm" href="/projects/create">Adicionar projeto</a>
    </section>

    <?php if ($projects === []): ?>
        <section class="empty-state">
            Nenhum projeto cadastrado ainda. Crie o primeiro projeto para liberar o Gantt individual.
        </section>
    <?php else: ?>
        <section class="projects-grid" aria-label="Lista de projetos">
            <?php foreach ($projects as $item): ?>
                <?php
                $project = $item['model'];
                $status = (string)$project->status;
                $progress = (int)$item['progress'];
                $members = $item['members'];
                ?>
                <article class="project-card compact-project-card">
                    <div class="project-cover">
                        <?php if (!empty($project->image_path)): ?>
                            <img src="<?= htmlspecialchars((string)$project->image_path, ENT_QUOTES, 'UTF-8') ?>" alt="">
                        <?php else: ?>
                            <span><?= htmlspecialchars(strtoupper(substr((string)$project->name, 0, 1)), ENT_QUOTES, 'UTF-8') ?></span>
                        <?php endif; ?>
                    </div>

                    <div class="project-card-body">
                        <div class="project-card-top">
                            <div>
                                <h2><?= htmlspecialchars((string)$project->name, ENT_QUOTES, 'UTF-8') ?></h2>
                                <?php if (($auth['role'] ?? '') === 'master' && !empty($item['company_name'])): ?>
                                    <small><?= htmlspecialchars((string)$item['company_name'], ENT_QUOTES, 'UTF-8') ?></small>
                                <?php endif; ?>
                                <p><?= htmlspecialchars((string)($project->description ?: 'Sem descricao.'), ENT_QUOTES, 'UTF-8') ?></p>
                            </div>
                            <span class="status-pill <?= htmlspecialchars($statusClasses[$status] ?? 'status-muted', ENT_QUOTES, 'UTF-8') ?>">
                                <?= htmlspecialchars($statusLabels[$status] ?? $status, ENT_QUOTES, 'UTF-8') ?>
                            </span>
                        </div>

                        <div class="project-meta-grid">
                            <div>
                                <small>Lider</small>
                                <strong><?= htmlspecialchars((string)($item['leader'] ?? 'Nao definido'), ENT_QUOTES, 'UTF-8') ?></strong>
                            </div>
                            <div>
                                <small>Prazo</small>
                                <strong><?= htmlspecialchars((string)($project->deadline ?: 'Sem prazo'), ENT_QUOTES, 'UTF-8') ?></strong>
                            </div>
                            <div>
                                <small>Tarefas</small>
                                <strong><?= (int)$item['tasks_done'] ?>/<?= (int)$item['tasks_total'] ?></strong>
                            </div>
                            <div>
                                <small>Anexos</small>
                                <strong><?= (int)$item['files_count'] ?></strong>
                            </div>
                        </div>

                        <div class="project-team">
                            <small>Responsaveis</small>
                            <div class="avatar-row">
                                <?php foreach (array_slice($members, 0, 4) as $member): ?>
                                    <span title="<?= htmlspecialchars((string)$member, ENT_QUOTES, 'UTF-8') ?>">
                                        <?= htmlspecialchars(strtoupper(substr((string)$member, 0, 1)), ENT_QUOTES, 'UTF-8') ?>
                                    </span>
                                <?php endforeach; ?>
                                <?php if (count($members) > 4): ?>
                                    <span>+<?= count($members) - 4 ?></span>
                                <?php endif; ?>
                                <?php if ($members === []): ?>
                                    <em>Nenhum responsavel</em>
                                <?php endif; ?>
                            </div>
                        </div>

                        <div class="progress-head">
                            <span>Avanco</span>
                            <strong><?= $progress ?>%</strong>
                        </div>
                        <div class="progress-track" aria-label="Avanco de <?= $progress ?>%">
                            <span style="width: <?= $progress ?>%"></span>
                        </div>

                        <div class="project-actions">
                            <a class="btn btn-secondary btn-sm" href="/projects/<?= (int)$project->id ?>/edit">Editar</a>
                            <a class="btn btn-primary btn-sm" href="/projects/<?= (int)$project->id ?>/gantt" target="_blank" rel="noopener">Gantt</a>
                        </div>
                    </div>
                </article>
            <?php endforeach; ?>
        </section>
    <?php endif; ?>
</main>

<?php $this->partial('footer'); ?>
