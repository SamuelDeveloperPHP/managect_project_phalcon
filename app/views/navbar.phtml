<header class="topbar">
    <div class="topbar-brand">
        <?php if (!empty($auth['company_logo'])): ?>
            <img class="company-logo" src="<?= htmlspecialchars((string)$auth['company_logo'], ENT_QUOTES, 'UTF-8') ?>" alt="Logo">
        <?php else: ?>
            <span class="brand-mark"><?= strtoupper(substr((string)($auth['company_name'] ?? 'P'), 0, 1)) ?></span>
        <?php endif; ?>
        <div>
            <strong><?= htmlspecialchars((string)($auth['company_name'] ?? 'Minha Empresa'), ENT_QUOTES, 'UTF-8') ?></strong>
            <small>Domínio: <?= htmlspecialchars((string)($auth['company_domain'] ?? 'SaaS'), ENT_QUOTES, 'UTF-8') ?></small>
        </div>
    </div>

    <div class="topbar-user">
        <span class="user-avatar">
            <?= strtoupper(substr((string)($auth['name'] ?? 'A'), 0, 1)) ?>
        </span>
        <div>
            <strong><?= htmlspecialchars((string)($auth['name'] ?? ''), ENT_QUOTES, 'UTF-8') ?></strong>
            <small><?php
                echo match ($auth['role'] ?? '') {
                    'master' => 'Master',
                    'admin' => 'Administrador',
                    default => 'Usuário',
                };
            ?></small>
        </div>
    </div>
</header>
