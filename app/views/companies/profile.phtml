<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnCnpj = document.getElementById('btn-cnpj-lookup');
    const btnCep = document.getElementById('btn-cep-lookup');

    btnCnpj.addEventListener('click', async function() {
        const cnpj = document.getElementById('cnpj').value.replace(/\D/g, '');
        if (!cnpj || cnpj.length !== 14) {
            Swal.fire('Atenção', 'Informe um CNPJ válido com 14 dígitos.', 'warning');
            return;
        }

        btnCnpj.disabled = true;
        btnCnpj.textContent = 'Buscando...';

        try {
            const resp = await fetch('/companies/cnpj-lookup?cnpj=' + cnpj);
            const json = await resp.json();

            if (json.success && json.data) {
                const d = json.data;
                if (d.name) document.getElementById('name').value = d.name;
                if (d.zip_code) document.getElementById('zip_code').value = d.zip_code;
                if (d.street) document.getElementById('street').value = d.street;
                if (d.number) document.getElementById('number').value = d.number;
                if (d.complement) document.getElementById('complement').value = d.complement;
                if (d.neighborhood) document.getElementById('neighborhood').value = d.neighborhood;
                if (d.city) document.getElementById('city').value = d.city;
                if (d.state) document.getElementById('state').value = d.state;
                if (d.email && !document.getElementById('contact_email').value) {
                    document.getElementById('contact_email').value = d.email;
                }

                Swal.fire('Sucesso', 'Dados do CNPJ preenchidos automaticamente!', 'success');
            } else {
                Swal.fire('Erro', json.message || 'CNPJ não encontrado.', 'error');
            }
        } catch (err) {
            Swal.fire('Erro', 'Não foi possível consultar a API de CNPJ.', 'error');
        } finally {
            btnCnpj.disabled = false;
            btnCnpj.textContent = '🔍 Buscar CNPJ';
        }
    });

    btnCep.addEventListener('click', async function() {
        const cep = document.getElementById('zip_code').value.replace(/\D/g, '');
        if (!cep || cep.length !== 8) {
            Swal.fire('Atenção', 'Informe um CEP válido com 8 dígitos.', 'warning');
            return;
        }

        try {
            const resp = await fetch('/companies/cep-lookup?cep=' + cep);
            const json = await resp.json();

            if (json.success && json.data) {
                const d = json.data;
                if (d.street) document.getElementById('street').value = d.street;
                if (d.neighborhood) document.getElementById('neighborhood').value = d.neighborhood;
                if (d.city) document.getElementById('city').value = d.city;
                if (d.state) document.getElementById('state').value = d.state;
            } else {
                Swal.fire('Erro', json.message || 'CEP não encontrado.', 'error');
            }
        } catch (err) {
            Swal.fire('Erro', 'Não foi possível consultar o CEP.', 'error');
        }
    });
});
</script>

