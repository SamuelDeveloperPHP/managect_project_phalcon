    <!-- Minimal overrides - only layout, nothing visual -->
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            background-color: #fff;
        }

        /* Top nav bar - minimal, original-style */
        #gantt-topbar {
            position: fixed;
            top: 0;
            right: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 8px;
            background: transparent;
            pointer-events: none;
        }

        #gantt-topbar > * {
            pointer-events: auto;
        }

        #gantt-topbar a.btn-projects {
            font-family: "HelveticaNeue-Light", "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #2b9af3;
            text-decoration: none;
            font-weight: bold;
            padding: 2px 8px;
            border: 1px solid #2b9af3;
            border-radius: 3px;
            background: #fff;
        }

        #gantt-topbar a.btn-projects:hover {
            background: #e8f4ff;
            text-decoration: none;
        }

        #gantt-topbar button.btn-save {
            font-family: "HelveticaNeue-Light", "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #fff;
            background: #2b9af3;
            border: 1px solid #1a7fd4;
            border-radius: 3px;
            padding: 2px 10px;
            cursor: pointer;
            font-weight: bold;
        }

        #gantt-topbar button.btn-save:hover {
            background: #1a7fd4;
        }

        /* Status toast - floating bottom-left, non-intrusive */
        #gantt-toast {
            position: fixed;
            bottom: 12px;
            left: 12px;
            z-index: 9999;
            max-width: 420px;
            padding: 6px 12px;
            border-radius: 4px;
            font-family: "HelveticaNeue-Light", "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #617777;
            background: #E3EDED;
            border: 1px solid #bbb;
            display: none;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }

        #gantt-toast.info    { background: #d6eeff; border-color: #2b9af3; color: #0c4e8c; }
        #gantt-toast.success { background: #d4f5e2; border-color: #3aae6c; color: #1a6b3a; }
        #gantt-toast.error   { background: #ffe0e0; border-color: #e05252; color: #8b1a1a; }

        /* workspace fills viewport */
        #workSpace {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            overflow: hidden;
        }

        /* ganttButtonBar h1 - same as gantt.html inline style */
        .ganttButtonBar h1 {
            color: #000000;
            font-weight: bold;
            font-size: 28px;
            margin-left: 10px;
        }

        #workSpace:fullscreen {
            width: 100vw;
            height: 100vh;
            background: #fff;
        }

        #workSpace:-webkit-full-screen {
            width: 100vw;
            height: 100vh;
            background: #fff;
        }

        #fullscrbtn {
            width: 28px;
            height: 28px;
            text-align: center;
            vertical-align: middle;
        }

        #fullscrbtn .teamworkIcon {
            display: none;
        }

        #fullscrbtn .gantt-fullscreen-icon {
            display: inline-block;
            width: 16px;
            height: 16px;
            vertical-align: -3px;
            background:
                linear-gradient(#34495e, #34495e) left top / 7px 2px no-repeat,
                linear-gradient(#34495e, #34495e) left top / 2px 7px no-repeat,
                linear-gradient(#34495e, #34495e) right top / 7px 2px no-repeat,
                linear-gradient(#34495e, #34495e) right top / 2px 7px no-repeat,
                linear-gradient(#34495e, #34495e) left bottom / 7px 2px no-repeat,
                linear-gradient(#34495e, #34495e) left bottom / 2px 7px no-repeat,
                linear-gradient(#34495e, #34495e) right bottom / 7px 2px no-repeat,
                linear-gradient(#34495e, #34495e) right bottom / 2px 7px no-repeat;
        }

        #fullscrbtn.is-fullscreen {
            background: #e8f4ff;
            border-radius: 3px;
        }

        #fullscrbtn.is-fullscreen .gantt-fullscreen-icon {
            background:
                linear-gradient(#34495e, #34495e) left 4px top 4px / 6px 2px no-repeat,
                linear-gradient(#34495e, #34495e) left 4px top 4px / 2px 6px no-repeat,
                linear-gradient(#34495e, #34495e) right 4px top 4px / 6px 2px no-repeat,
                linear-gradient(#34495e, #34495e) right 4px top 4px / 2px 6px no-repeat,
                linear-gradient(#34495e, #34495e) left 4px bottom 4px / 6px 2px no-repeat,
                linear-gradient(#34495e, #34495e) left 4px bottom 4px / 2px 6px no-repeat,
                linear-gradient(#34495e, #34495e) right 4px bottom 4px / 6px 2px no-repeat,
                linear-gradient(#34495e, #34495e) right 4px bottom 4px / 2px 6px no-repeat;
        }
    </style>
